/* 全局样式，所有页面都会继承。rpx 是小程序的响应式单位：屏幕宽固定 750rpx */
page {
  background-color: #f7f7f7;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #999;
  font-size: 24rpx;
}
